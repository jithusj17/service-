{
    # Global options
    email {$TLS_EMAIL}
}

{$DOMAIN:localhost} {
    # Reverse proxy for Next.js frontend
    handle /* {
        reverse_proxy web:3000
    }

    # Reverse proxy for NestJS API (load balanced automatically if scaled)
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy api:3001
    }

    # Reverse proxy for MinIO object storage API
    handle /storage/* {
        uri strip_prefix /storage
        reverse_proxy minio:9000
    }

    # Compress responses
    encode zstd gzip
}

grafana.{$DOMAIN:localhost} {
    reverse_proxy grafana:3000
}

minio.{$DOMAIN:localhost} {
    reverse_proxy minio:9001
}
