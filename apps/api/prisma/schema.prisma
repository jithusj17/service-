generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tenant ──────────────────────────────────────
model Tenant {
  id        String   @id @default(uuid())
  name      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  auditEvents AuditEvent[]
  customers   Customer[]
  assets          Asset[]
  serviceRequests ServiceRequest[]
  workOrders      WorkOrder[]
  workOrderTimelineEvents WorkOrderTimelineEvent[]
  diagnoses       Diagnosis[]
  estimates       Estimate[]

  @@map("tenants")
}

// ─── Enums ───────────────────────────────────────
enum Role {
  OWNER
  ADMIN
  MANAGER
  TECHNICIAN
  STAFF
  CUSTOMER
}

enum AssetType {
  BICYCLE
}

enum ServiceRequestState {
  SUBMITTED
  REVIEWING
  ACCEPTED
  REJECTED
  CONVERTED_TO_WORK_ORDER
}

enum ServiceRequestPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WorkOrderStatus {
  RECEIVED
  DIAGNOSING
  WAITING_FOR_APPROVAL
  APPROVED
  WAITING_FOR_PARTS
  IN_REPAIR
  QUALITY_CHECK
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum WorkOrderPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DiagnosisSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EstimateStatus {
  DRAFT
  SENT
  VIEWED
  APPROVED
  REJECTED
  EXPIRED
}

// ─── User ────────────────────────────────────────
model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String
  name            String
  role            Role     @default(OWNER)
  status          String   @default("ACTIVE")
  isEmailVerified Boolean  @default(false)
  tenantId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions                Session[]
  verificationTokens      VerificationToken[]
  auditEvents             AuditEvent[]
  assignedWorkOrders      WorkOrder[]
  workOrderTimelineEvents WorkOrderTimelineEvent[]

  @@index([tenantId])
  @@map("users")
}

// ─── Session (Refresh Tokens) ────────────────────
model Session {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

// ─── Verification Token ──────────────────────────
model VerificationToken {
  id        String    @id @default(uuid())
  userId    String
  type      String    // e.g., "EMAIL_VERIFICATION", "PASSWORD_RESET"
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("verification_tokens")
}

// ─── Audit Event ─────────────────────────────────
model AuditEvent {
  id        String   @id @default(uuid())
  action    String   // e.g., "USER_LOGIN", "PASSWORD_RESET"
  userId    String?
  tenantId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tenantId])
  @@index([action])
  @@map("audit_events")
}

// ─── Customer ────────────────────────────────────
model Customer {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String?
  phone     String?
  address   Json?
  notes     String?
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assets          Asset[]
  serviceRequests ServiceRequest[]
  workOrders      WorkOrder[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("customers")
}

// ─── Asset ───────────────────────────────────────
model Asset {
  id           String    @id @default(uuid())
  customerId   String
  tenantId     String
  assetType    AssetType @default(BICYCLE)
  brand        String?
  model        String?
  serialNumber String?
  color        String?
  notes        String?
  attributes   Json?     // Type-specific data (e.g. year, bicycleType)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceRequests ServiceRequest[]
  workOrders      WorkOrder[]

  @@index([tenantId])
  @@index([customerId])
  @@map("assets")
}

// ─── Service Request ─────────────────────────────
model ServiceRequest {
  id                 String                 @id @default(uuid())
  customerId         String
  tenantId           String
  assetId            String
  problemDescription String
  priority           ServiceRequestPriority @default(MEDIUM)
  state              ServiceRequestState    @default(SUBMITTED)
  attachments        Json?                  // Mock for file uploads (array of objects)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
  @@index([assetId])
  @@map("service_requests")
}

// ─── Work Order ──────────────────────────────────
model WorkOrder {
  id              String            @id @default(uuid())
  workOrderNumber String
  tenantId        String
  customerId      String
  assetId         String
  technicianId    String?
  problem         String
  priority        WorkOrderPriority @default(MEDIUM)
  status          WorkOrderStatus   @default(RECEIVED)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tenant     Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  asset      Asset                    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  technician User?                    @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  timeline   WorkOrderTimelineEvent[]
  diagnosis  Diagnosis?
  estimates  Estimate[]

  @@unique([tenantId, workOrderNumber])
  @@index([tenantId])
  @@index([customerId])
  @@index([assetId])
  @@index([technicianId])
  @@map("work_orders")
}

// ─── Work Order Timeline Event ───────────────────
model WorkOrderTimelineEvent {
  id          String   @id @default(uuid())
  workOrderId String
  tenantId    String
  userId      String?
  type        String   // e.g., "STATUS_CHANGE", "NOTE_ADDED"
  details     Json?
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workOrderId])
  @@index([tenantId])
  @@map("work_order_timeline_events")
}

// ─── Diagnosis ───────────────────────────────────
model Diagnosis {
  id             String            @id @default(uuid())
  workOrderId    String            @unique
  tenantId       String
  problemFound   String
  recommendation String
  severity       DiagnosisSeverity @default(MEDIUM)
  notes          String?
  attachments    Json?             // Array of { name, url, etc. }
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("diagnoses")
}

// ─── Estimate ────────────────────────────────────
model Estimate {
  id             String         @id @default(uuid())
  workOrderId    String
  tenantId       String
  status         EstimateStatus @default(DRAFT)
  laborItems     Json?          // Array of { id, name, hours, rate, total }
  parts          Json?          // Array of { id, name, quantity, price, total }
  subtotal       Float          @default(0)
  tax            Float          @default(0)
  discount       Float          @default(0)
  total          Float          @default(0)
  expirationDate DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@index([tenantId])
  @@map("estimates")
}
