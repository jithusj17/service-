generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tenant ──────────────────────────────────────
model Tenant {
  id        String   @id @default(uuid())
  name      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  auditEvents AuditEvent[]
  customers   Customer[]
  assets      Asset[]
  serviceRequests ServiceRequest[]

  @@map("tenants")
}

// ─── Enums ───────────────────────────────────────
enum Role {
  OWNER
  ADMIN
  MANAGER
  TECHNICIAN
  STAFF
  CUSTOMER
}

enum AssetType {
  BICYCLE
}

enum ServiceRequestState {
  SUBMITTED
  REVIEWING
  ACCEPTED
  REJECTED
  CONVERTED_TO_WORK_ORDER
}

enum ServiceRequestPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ─── User ────────────────────────────────────────
model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String
  name            String
  role            Role     @default(OWNER)
  status          String   @default("ACTIVE")
  isEmailVerified Boolean  @default(false)
  tenantId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions           Session[]
  verificationTokens VerificationToken[]
  auditEvents        AuditEvent[]

  @@index([tenantId])
  @@map("users")
}

// ─── Session (Refresh Tokens) ────────────────────
model Session {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

// ─── Verification Token ──────────────────────────
model VerificationToken {
  id        String    @id @default(uuid())
  userId    String
  type      String    // e.g., "EMAIL_VERIFICATION", "PASSWORD_RESET"
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("verification_tokens")
}

// ─── Audit Event ─────────────────────────────────
model AuditEvent {
  id        String   @id @default(uuid())
  action    String   // e.g., "USER_LOGIN", "PASSWORD_RESET"
  userId    String?
  tenantId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tenantId])
  @@index([action])
  @@map("audit_events")
}

// ─── Customer ────────────────────────────────────
model Customer {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String?
  phone     String?
  address   Json?
  notes     String?
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assets Asset[]
  serviceRequests ServiceRequest[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("customers")
}

// ─── Asset ───────────────────────────────────────
model Asset {
  id           String    @id @default(uuid())
  customerId   String
  tenantId     String
  assetType    AssetType @default(BICYCLE)
  brand        String?
  model        String?
  serialNumber String?
  color        String?
  notes        String?
  attributes   Json?     // Type-specific data (e.g. year, bicycleType)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceRequests ServiceRequest[]

  @@index([tenantId])
  @@index([customerId])
  @@map("assets")
}

// ─── Service Request ─────────────────────────────
model ServiceRequest {
  id                 String                 @id @default(uuid())
  customerId         String
  tenantId           String
  assetId            String
  problemDescription String
  priority           ServiceRequestPriority @default(MEDIUM)
  state              ServiceRequestState    @default(SUBMITTED)
  attachments        Json?                  // Mock for file uploads (array of objects)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
  @@index([assetId])
  @@map("service_requests")
}
